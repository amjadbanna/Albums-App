@model AlbumsViewModel

@{
    string featuredAlbum = $"{Model.RandomAlbum}";

    string baseCssClass = "nav-link";
    string cssClass = "";
}

<div class="row">
    <ul class="nav nav-tabs mb-3">
        @if (Model.ActiveGenre == "All")
        {
            cssClass = baseCssClass + " active";
        }
        else
        {
            cssClass = baseCssClass;
        }
        <li class="nav-item">
            <a class="@cssClass" asp-controller="Album" asp-action="GetAlbums" asp-route-genre="">All</a>
        </li>

        @foreach(string tabName in Model.Genres)
        {
            if (Model.ActiveGenre == tabName)
            {
                cssClass = baseCssClass + " active";
            }
            else
            {
                cssClass = baseCssClass;
            }

            <li class="nav-item">
                <a class="@cssClass" asp-controller="Album" asp-action="GetAlbums" asp-route-genre="@tabName">@tabName</a>
            </li>
        }
    </ul>
</div>
<div class="row my-2">
    <div class="col-sm-12 col-md-6">
        @if (Model.Albums.Count > 0)
        {
            <ul>
                @foreach (Album album in Model.Albums)
                {
                    <li><a asp-controller="Album" asp-action="GetAlbumById" asp-route-id="@album.Id">@(album.ToString())</a></li>
                }
            </ul>
        }
        else
        {
            <p>No albums to show</p>
        }
    </div>
    <div class="col-sm-12 col-md-6">
        <h6>Featured album: @featuredAlbum</h6>
        <div>
            <img alt="@featuredAlbum cover" src="@Model.RandomAlbum.CoverImageUrl" class="img-fluid rounded"/>
        </div>
    </div>
</div>

<div class="mt-3">
    <h6>Add a new album..</h6>
    
    <div asp-validation-summary="All" class="text-danger"></div>
    
    <form method="post" asp-controller="Album" asp-action="AddNewAlbum" class="row g-3">
        <!-- stuff the active genre here as a hidden field to send back to the server via POST body: -->
        <input type="hidden" asp-for="ActiveGenre"/>
        
        <div class="col-sm-3">
            <input type="text" asp-for="NewAlbum.Title" class="form-control" placeholder="Title" aria-label="Title"/>
        </div>
        <div class="col-sm-2">
            <input type="text" asp-for="NewAlbum.Artist" class="form-control" placeholder="Artist" aria-label="Artist"/>
        </div>
        <div class="col-sm-1">
            <input type="text" asp-for="NewAlbum.Year" class="form-control" placeholder="Year" aria-label="Year"/>
        </div>
        <div class="col-sm-2">
            <select asp-for="NewAlbum.Genre" class="form-control">
                <option value="">Pick genre..</option>
                @foreach (string genre in Model.Genres)
                {
                    <option value="@genre">@genre</option>
                }
            </select>
        </div>
        <div class="col-sm-3">
            <input type="text" asp-for="NewAlbum.CoverImageUrl" class="form-control" placeholder="Cover image URL" aria-label="Cover image URL"/>
        </div>
        <div class="col-sm-1">
            <button type="submit" class="btn btn-primary">Add</button>
        </div>
    </form>
</div>
