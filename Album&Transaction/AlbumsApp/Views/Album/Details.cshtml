@model Album

@{
    ViewData["Title"] = Model.Title;
}

<div class="row mb-3">
    <div class="col-3">
        <img src="@Model.CoverImageUrl" alt="@Model.Title cover" class="img-fluid rounded">
    </div>
    <div class="col">
        <h4>@Model.Title</h4>
        <p><strong>Artist:</strong> @Model.Artist</p>
        <p><strong>Year:</strong> @Model.Year</p>
        <p><strong>Genre:</strong> @Model.Genre</p>
    </div>
</div>

<p class="mt-3">Return back to <a asp-controller="Album" asp-action="GetAlbums">all albums</a></p>
